# Database (PostgreSQL Connection String)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/bidxact_db

# Stripe Integration
STRIPE_SECRET_KEY=sk_test_51Nx_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Server & App Config
PORT=3000
APP_URL=http://localhost:3000

# Gemini API
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
# Authentication
# Required in production. Use a random secret of at least 32 characters.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000
# Development-only compatibility with the legacy x-user-id header. Never enable in production.
ALLOW_DEV_HEADER_AUTH=true
